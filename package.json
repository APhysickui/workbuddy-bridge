{
  "name": "workbuddy-bridge",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Use WorkBuddy models in pi, Claude Code, Kimi Code and local API clients through the official CodeBuddy CLI",
  "license": "MIT",
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "init": "node scripts/init.mjs",
    "start": "node --env-file-if-exists=.env src/main.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "models": "node --env-file-if-exists=.env scripts/models.mjs",
    "probe": "node --env-file-if-exists=.env scripts/probe.mjs",
    "agent:check": "node --env-file-if-exists=.env scripts/agent-check.mjs",
    "demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "claude": "node --env-file-if-exists=.env scripts/claude.mjs",
    "claude:check": "node --env-file-if-exists=.env scripts/claude.mjs --check",
    "claude:install": "node --env-file-if-exists=.env scripts/install-direct-claude.mjs",
    "claude:uninstall": "node --env-file-if-exists=.env scripts/uninstall-direct-claude.mjs",
    "pi": "node --env-file-if-exists=.env scripts/pi.mjs",
    "pi:check": "node --env-file-if-exists=.env scripts/pi.mjs --check",
    "pi:unify": "node scripts/unify-pi.mjs",
    "kimi": "node --env-file-if-exists=.env scripts/kimi.mjs",
    "kimi:check": "node --env-file-if-exists=.env scripts/kimi.mjs --check",
    "kimi:install": "node --env-file-if-exists=.env scripts/kimi-install.mjs",
    "local:repair": "node --env-file-if-exists=.env scripts/local-repair.mjs",
    "integration:check": "node --env-file-if-exists=.env scripts/integration-check.mjs",
    "bridge:stop": "node --env-file-if-exists=.env scripts/stop-bridge.mjs",
    "bridge:restart": "node --env-file-if-exists=.env scripts/restart-bridge.mjs",
    "claude:restore": "node scripts/restore-claude-default.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
