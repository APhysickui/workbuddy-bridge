# mock = local demo, workbuddy = invoke the bundled CLI using its normal login
BRIDGE_BACKEND=mock
BRIDGE_PORT=18765
BRIDGE_API_KEY=replace-with-a-random-local-key
BRIDGE_TIMEOUT_MS=120000
BRIDGE_MAX_BODY_BYTES=2097152
# Public aliases = official CLI IDs; limits and default context come from src/workbuddy-models.json
BRIDGE_MODELS=deepseek-v4.1-flash=deepseek-v4.1-flash,fast-model=fast-model,balanced-model=balanced-model,deep-model=deep-model,hy4-preview=hy4-preview,hy3=hy3,hy3-x=hy3-x,space-bunny=space-bunny,glm-5.3=glm-5.3,glm-5.3-flash=glm-5.3-flash,glm-5.2=glm-5.2,glm-5.1=glm-5.1,glm-5v-turbo=glm-5v-turbo,minimax-m3=minimax-m3,kimi-k3-1=kimi-k3-1,kimi-k2.8-preview=kimi-k2.8-preview,kimi-k2.7=kimi-k2.7,kimi-k2.6=kimi-k2.6,deepseek-v4-pro=deepseek-v4-pro
BRIDGE_CLAUDE_MODEL=deepseek-v4.1-flash
BRIDGE_CLAUDE_MODEL_NAME=DeepSeek V4.1 Flash（workbuddy）
# Preserve original Claude models by forwarding them to the user's existing provider.
BRIDGE_CLAUDE_PASSTHROUGH=1
# Set this to the JavaScript CLI entry from: command -v codebuddy
# CODEBUDDY_BIN=/absolute/path/to/codebuddy
